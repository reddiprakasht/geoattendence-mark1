{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Geoattendance dev server",
      "type": "shell",
      "command": "npm run dev",
      "windows": {
        "command": "npm.cmd run dev"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> .* dev$",
          "endsPattern": "VITE v.* ready in .*"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
